  "facts": {
    "f_3b7515a01f60f34c": {
      "fact_id": "f_3b7515a01f60f34c",
      "canonical_text": "The Dalai Lama has a 'third way' in Tibet.",
      "polarity": "affirm",
      "mention_ids": [
        "m_b6b5e9eaafb99030",
        "m_7e3ab63dcad65eef"
      ],
      "properties": {}
    },
    "f_6dd7ad01733556a9": {
      "fact_id": "f_6dd7ad01733556a9",
      "canonical_text": "The USA has been vocal in its support for the 'Middle Way' strategy.",
      "polarity": "affirm",
      "mention_ids": [
        "m_6fb6bd413c18b17a"
      ],
      "properties": {}
    },
    "f_f304d59c352f6534": {
      "fact_id": "f_f304d59c352f6534",
      "canonical_text": "The US has not given any indication that it would support complete Tibetan independence.",
      "polarity": "negate",
      "mention_ids": [
        "m_27d309208f0f4cbf"
      ],
      "properties": {}
    },
    "f_da10e09912d338ae": {
      "fact_id": "f_da10e09912d338ae",
      "canonical_text": "The US is unlikely to support complete Tibetan independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_062f188f4b16095a"
      ],
      "properties": {}
    },
    "f_e18f07c91603b76f": {
      "fact_id": "f_e18f07c91603b76f",
      "canonical_text": "America is unlikely to jeopardise trade relations with China by giving political legitimacy to those advocating complete Tibetan independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_9161cacd7b7a9489"
      ],
      "properties": {}
    },
    "f_7acacfe38606c8f2": {
      "fact_id": "f_7acacfe38606c8f2",
      "canonical_text": "International support means the international community would accept any change when it occurs.",
      "polarity": "affirm",
      "mention_ids": [
        "m_915056bed1390ca4"
      ],
      "properties": {}
    },
    "f_e82f64ccda41dfba": {
      "fact_id": "f_e82f64ccda41dfba",
      "canonical_text": "International support gives China a further incentive to negotiate for some form of the 'Middle Way' as it would positively benefit its international relations.",
      "polarity": "affirm",
      "mention_ids": [
        "m_86699a7aed31ef61"
      ],
      "properties": {}
    },
    "f_82d5fa6eb65a2cd8": {
      "fact_id": "f_82d5fa6eb65a2cd8",
      "canonical_text": "The Dalai Lama believes complete independence is not a viable solution for the Tibet crisis.",
      "polarity": "affirm",
      "mention_ids": [
        "m_a644a4ae6c686aa7"
      ],
      "properties": {}
    },
    "f_33887a08922334ec": {
      "fact_id": "f_33887a08922334ec",
      "canonical_text": "The Dalai Lama's advocacy is aimed at creating common understanding between the Chinese and the Tibetans.",
      "polarity": "affirm",
      "mention_ids": [
        "m_a29baffc48e6bc51"
      ],
      "properties": {}
    },
    "f_30ec12cc35b3000a": {
      "fact_id": "f_30ec12cc35b3000a",
      "canonical_text": "The Dalai Lama points to the European Union as an example of a modern supranational political system.",
      "polarity": "affirm",
      "mention_ids": [
        "m_07be8022e2b0c8de"
      ],
      "properties": {}
    },
    "f_35668677bdf78a18": {
      "fact_id": "f_35668677bdf78a18",
      "canonical_text": "In the European Union model, different ethnicities and nationalities can cooperate to achieve an agreed ideal of prosperity.",
      "polarity": "affirm",
      "mention_ids": [
        "m_81a03553acfce5b5"
      ],
      "properties": {}
    },
    "f_d8ba3cafe468e024": {
      "fact_id": "f_d8ba3cafe468e024",
      "canonical_text": "The 'Middle Way' is described as the most practical and realistic path for Tibet and China.",
      "polarity": "affirm",
      "mention_ids": [
        "m_5d97054264159839"
      ],
      "properties": {}
    },
    "f_d0cf1fac8b9bb3f5": {
      "fact_id": "f_d0cf1fac8b9bb3f5",
      "canonical_text": "The 'Middle Way' bridges the needs of the Tibetan people with the interests of China.",
      "polarity": "affirm",
      "mention_ids": [
        "m_4065f5bb263d813f"
      ],
      "properties": {}
    },
    "f_3a0c1308a19e8e54": {
      "fact_id": "f_3a0c1308a19e8e54",
      "canonical_text": "The Chinese government manipulates people every day.",
      "polarity": "affirm",
      "mention_ids": [
        "m_3455d3f0b747dc11"
      ],
      "properties": {}
    },
    "f_e9413d425480a9fb": {
      "fact_id": "f_e9413d425480a9fb",
      "canonical_text": "Beijing is manipulating the good intentions of the Dalai Lama and his 'Middle Way'.",
      "polarity": "affirm",
      "mention_ids": [
        "m_d30a2f29a3a559a9"
      ],
      "properties": {}
    },
    "f_fd13db2b5a52f420": {
      "fact_id": "f_fd13db2b5a52f420",
      "canonical_text": "The Middle Path is described as not only hopeless but also dangerous.",
      "polarity": "affirm",
      "mention_ids": [
        "m_044eb1da89b3e246"
      ],
      "properties": {}
    },
    "f_f25f3e477615ceff": {
      "fact_id": "f_f25f3e477615ceff",
      "canonical_text": "Henry Kissinger once said that in politics, one never pays for goods that have already been delivered.",
      "polarity": "affirm",
      "mention_ids": [
        "m_a2ddef15c8a5390d"
      ],
      "properties": {}
    },
    "f_854bc7342007cc79": {
      "fact_id": "f_854bc7342007cc79",
      "canonical_text": "China is using the moderate stance of Tibet's leadership-in-exile to extort concessions while giving nothing of substance in return.",
      "polarity": "affirm",
      "mention_ids": [
        "m_1998db730c7b6c7e"
      ],
      "properties": {}
    },
    "f_2e7f3d96440f947a": {
      "fact_id": "f_2e7f3d96440f947a",
      "canonical_text": "Beijing spread false rumours that the Dalai Lama would be invited to China to prevent demonstrations when Hu Jintao visited the U.S.",
      "polarity": "affirm",
      "mention_ids": [
        "m_f27dacce3c18b1e4"
      ],
      "properties": {}
    },
    "f_b44785066e512536": {
      "fact_id": "f_b44785066e512536",
      "canonical_text": "The Dalai Lama advocates a 'Middle Way' rather than full independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_4413457ad89d72da"
      ],
      "properties": {}
    },
    "f_8df7c34d5b00f3a8": {
      "fact_id": "f_8df7c34d5b00f3a8",
      "canonical_text": "The Dalai Lama believes complete independence is not viable.",
      "polarity": "affirm",
      "mention_ids": [
        "m_c2c0e182b0c3a464"
      ],
      "properties": {}
    },
    "f_88a9ea343f5f8cf5": {
      "fact_id": "f_88a9ea343f5f8cf5",
      "canonical_text": "The Dalai Lama promotes cooperation modeled on the EU.",
      "polarity": "affirm",
      "mention_ids": [
        "m_e570ba6c1b977bbd"
      ],
      "properties": {}
    },
    "f_9a1b6884f299b4e3": {
      "fact_id": "f_9a1b6884f299b4e3",
      "canonical_text": "The Middle Way strategy receives international support.",
      "polarity": "affirm",
      "mention_ids": [
        "m_9cd9826a93c70251"
      ],
      "properties": {}
    },
    "f_23ed943b983277fd": {
      "fact_id": "f_23ed943b983277fd",
      "canonical_text": "The U.S. backs the Middle Way but not independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_c73ce621add72be4"
      ],
      "properties": {}
    },
    "f_cb21ae5d394e9ff0": {
      "fact_id": "f_cb21ae5d394e9ff0",
      "canonical_text": "E3 calls the Middle Way hopeless.",
      "polarity": "affirm",
      "mention_ids": [
        "m_cc94476baa7107e3"
      ],
      "properties": {}
    },
    "f_d966b7cc5b3aae27": {
      "fact_id": "f_d966b7cc5b3aae27",
      "canonical_text": "E4 notes the Dalai Lama's fading role.",
      "polarity": "affirm",
      "mention_ids": [
        "m_1c44e9aeb44aae18"
      ],
      "properties": {}
    },
    "f_47005c48c5c9143f": {
      "fact_id": "f_47005c48c5c9143f",
      "canonical_text": "The dossier questions the Middle Way's effectiveness.",
      "polarity": "affirm",
      "mention_ids": [
        "m_1598f65485ff1471"
      ],
      "properties": {}
    },
    "f_36ba93240e2a71a6": {
      "fact_id": "f_36ba93240e2a71a6",
      "canonical_text": "The Dalai Lama rejects full independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_ce6ec8e856747c82"
      ],
      "properties": {}
    },
    "f_459eb47a68124035": {
      "fact_id": "f_459eb47a68124035",
      "canonical_text": "The Dalai Lama advocates a cooperative, EU-style model.",
      "polarity": "affirm",
      "mention_ids": [
        "m_baebb222128e343d"
      ],
      "properties": {}
    },
    "f_7325bb893f2f2733": {
      "fact_id": "f_7325bb893f2f2733",
      "canonical_text": "The U.S. backs the Middle Way strategy over independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_d790152056747d17"
      ],
      "properties": {}
    },
    "f_6171ef04a5d878af": {
      "fact_id": "f_6171ef04a5d878af",
      "canonical_text": "E3 and E4 challenge the Middle Way's practicality and popularity.",
      "polarity": "affirm",
      "mention_ids": [
        "m_a640dbd98c8dde4d"
      ],
      "properties": {}
    },
    "f_2912e97a60a6a8c0": {
      "fact_id": "f_2912e97a60a6a8c0",
      "canonical_text": "The Middle Way is a real, recognized position.",
      "polarity": "affirm",
      "mention_ids": [
        "m_b3fbb186ed91db5c"
      ],
      "properties": {}
    },
    "f_68186c27593707cb": {
      "fact_id": "f_68186c27593707cb",
      "canonical_text": "The success of the Middle Way is unresolved.",
      "polarity": "affirm",
      "mention_ids": [
        "m_d615259a2633738b"
      ],
      "properties": {}
    },
    "f_d194b6bdcbd0ee1d": {
      "fact_id": "f_d194b6bdcbd0ee1d",
      "canonical_text": "The Dalai Lama advocates a 'Middle Way' distinct from both full independence and the status quo.",
      "polarity": "affirm",
      "mention_ids": [
        "m_f4ac6836c0b35f0a"
      ],
      "properties": {}
    },
    "f_1d36eabbdaeb1a94": {
      "fact_id": "f_1d36eabbdaeb1a94",
      "canonical_text": "E2 states the Dalai Lama rejects independence as nonviable and proposes EU-style cooperation.",
      "polarity": "affirm",
      "mention_ids": [
        "m_c9f56f60ddd220e2"
      ],
      "properties": {}
    },
    "f_2abfc446cd337264": {
      "fact_id": "f_2abfc446cd337264",
      "canonical_text": "E1 confirms the U.S. backs the Middle Way position while not endorsing independence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_dad70f353df7830e"
      ],
      "properties": {}
    },
    "f_f5b2580a437efb5b": {
      "fact_id": "f_f5b2580a437efb5b",
      "canonical_text": "Panelists B and C note that E3 and E4 attack the strategy's effectiveness, influence, and Beijing's response, not its existence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_3d5a3f77259f7129"
      ],
      "properties": {}
    },
    "f_b36f6b8e6c5f5dd2": {
      "fact_id": "f_b36f6b8e6c5f5dd2",
      "canonical_text": "E4 confirms the Dalai Lama's support for the Middle Way may have reduced his influence.",
      "polarity": "affirm",
      "mention_ids": [
        "m_180925e797d2608d"
      ],
      "properties": {}
    },
    "f_fa8c6dd07d300652": {
      "fact_id": "f_fa8c6dd07d300652",
      "canonical_text": "No evidence shows the Dalai Lama abandoned the Middle Way.",
      "polarity": "affirm",
      "mention_ids": [
        "m_c7d005516505c160"
      ],
      "properties": {}
    },
    "f_06d7b7c2119aaa36": {
      "fact_id": "f_06d7b7c2119aaa36",
      "canonical_text": "The verdict on the claim is SUPPORT.",
      "polarity": "affirm",
      "mention_ids": [
        "m_818c59d5e0939ada"
      ],
      "properties": {}
    }
  },
