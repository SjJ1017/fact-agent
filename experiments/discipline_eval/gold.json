{
  "note": "32 deliberately selected real facts labelled by this agent before model tests; development sanity set, not independent human gold.",
  "items": [
    {
      "case": "idr-gen-level_1-12",
      "uid": "f8538aa7a97d7e2c8c4e",
      "text": "CompuCell3D allows rapid and intuitive modeling of multi-cellular behaviors.",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_b4ead78e85a36586"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "9a662690b4c064a02de8",
      "text": "Training was performed purely on observation without knowledge of underlying governing equations.",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_389c1243910f39e4"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "96fb005344ecfc10b2f0",
      "text": "Runtime is compared.",
      "topic": "G",
      "paper": "P",
      "original_fact_id": "f_0c8032904c7c3512"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "81bed281fd55a286593f",
      "text": "Given a cell configuration, the conditional GAN predicts the steady-state chemical field that CompuCell3D would compute",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_c18b83b596754527"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "d7ed952991b1a751d113",
      "text": "The surrogate is coupled into CompuCell3D",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_faa285163fccb083"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "e0bb965d3bf2e8815e53",
      "text": "Paper-b does not specify field-solver API or runtime.",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_e968ae0d781e25da"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "ed520ec96838049b2381",
      "text": "The research design saves CC3D steady morphogen field.",
      "topic": "B",
      "paper": "P",
      "original_fact_id": "f_f437aa1c824b054d"
    },
    {
      "case": "idr-gen-level_1-12",
      "uid": "82d8507b017dde771947",
      "text": "During coupling, cGAN is called.",
      "topic": "C",
      "paper": "P",
      "original_fact_id": "f_212e0f905c42123f"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "65edcce14a88b15fbb4c",
      "text": "Regulation is one of the three electric markets.",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_d8ef439ff8bb5162"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "0450c913c36234a47e9a",
      "text": "Public charger awareness is not a strong predictor of plug-in electric vehicle interest.",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_168cb8404a9704cb"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "3d33aedb0cd4341916d8",
      "text": "Paper-b provides equations calculating net revenue for peak power.",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_105585a9c469c9d9"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "4cd765715d5f5a4ae10b",
      "text": "A significant bivariate relationship exists between public charger awareness and plug-in electric vehicle interest.",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_5732e065fea5b8f4"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "2eec40b61f76aa787b31",
      "text": "Personalized V2G net revenue estimates convert weak charger visibility into an economically valid financial signal.",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_0ca2bd5845f3c1c7"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "21140cfe47cd880dbaca",
      "text": "The study collects consumer response to V2G revenue.",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_fa6f112989850345"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "d220b562143bd35cf04f",
      "text": "The research design measures baseline public charger awareness as none, one, or multiple.",
      "topic": "C",
      "paper": "P",
      "original_fact_id": "f_2819b25b65a69899"
    },
    {
      "case": "idr-gen-level_1-9",
      "uid": "6022530ed1ce0de69386",
      "text": "V2G-capable public charging is treated as a proposed intervention",
      "topic": "B",
      "paper": "P",
      "original_fact_id": "f_943884f8f288bea0"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "b38c53745626c2de3126",
      "text": "Paper-c characterizes LCP codes within quasicyclic families",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_fed72e07d4a70df8"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "0f69d65bca9c748eef77",
      "text": "Paper-b studies MDS LCP algebraic geometry codes",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_153143dac9611924"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "d3e83dd90c93259aa22a",
      "text": "This project tests whether cyclic automorphisms of elliptic curves produce quasi-cyclic AG LCP pairs.",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_7bfbde3a5a5c0708"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "417af7fb8545cb41c90d",
      "text": "The project builds paper-b AG LCP pairs from union of σ-orbits.",
      "topic": "B",
      "paper": "P",
      "original_fact_id": "f_104c236a3a731c76"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "daa11d6ca8dc0e7d6ee6",
      "text": "The project tests whether paper-c's constacyclic dual-equivalence condition holds",
      "topic": "C",
      "paper": "P",
      "original_fact_id": "f_9453f1ed18024c06"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "cc32ce9990284aafb6dc",
      "text": "Comparison with Paper-c's binary bound is done only after recomputing for AG-derived codes",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_80c53db4b1ee63d6"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "c945fee9c28af76ddf2d",
      "text": "For small finite fields F_q, the research constructs elliptic-curve AG codes C and D following paper-b.",
      "topic": "B",
      "paper": "P",
      "original_fact_id": "f_c7bc26e25dd9aa92"
    },
    {
      "case": "idr-gen-level_1-2",
      "uid": "8d286bbb954332fe3c59",
      "text": "The research imposes constacyclic shift constraints from paper-c.",
      "topic": "C",
      "paper": "P",
      "original_fact_id": "f_955dc32ed6beebb3"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "3e951c5c15cf3d3316ba",
      "text": "Paper-b enables operator functions of H",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_ae00c0b81da07ed7"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "72e07dec4f91ceaae345",
      "text": "Paper-b provides operator-function access",
      "topic": "B",
      "paper": "B",
      "original_fact_id": "f_c0dc34b6d97232d6"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "614b97d0f2e10774573e",
      "text": "QSP is a three-step method",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_d835eaa7beafe45a"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "df7660bee136814298c7",
      "text": "QSP processes rotation angles with a sequence of single-qubit rotations.",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_e73ec9ae8fcf50c2"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "03011e1eec11d07d2790",
      "text": "The third step of quantum signal processing is projecting with near unity success probability.",
      "topic": "C",
      "paper": "C",
      "original_fact_id": "f_c0cdf31c89955e9e"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "19bde5119250c2483108",
      "text": "The fused compiler feeds qubitization's SU(2) block-encoded signal into quantum signal processing",
      "topic": "X",
      "paper": "P",
      "original_fact_id": "f_b5e36f053461b668"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "ac38857394ca4ce7829a",
      "text": "The research measures infidelity to exact e^(-iHt)",
      "topic": "G",
      "paper": "P",
      "original_fact_id": "f_fb8f59b6e4163100"
    },
    {
      "case": "idr-gen-level_1-55",
      "uid": "9a251b3950dca3cf1a94",
      "text": "The integration adopts Researcher A's mechanism",
      "topic": "G",
      "paper": "P",
      "original_fact_id": "f_184d64a5c1770b2c"
    }
  ]
}
